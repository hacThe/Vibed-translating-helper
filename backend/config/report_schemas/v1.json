{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revised_title", "paragraphs", "revised_article", "key_lessons", "editing_checklist"],
  "properties": {
    "schema_version": { "type": "string", "const": "v1" },
    "revised_title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "translation_text", "revised_text", "notes"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "translation_text": { "type": "string", "minLength": 1, "maxLength": 30000 },
          "revised_text": { "type": "string", "minLength": 1, "maxLength": 30000 },
          "notes": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["original_text", "occurrence", "correction", "category", "explanation_en", "note_vi"],
              "properties": {
                "original_text": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "occurrence": { "type": "integer", "minimum": 1, "maximum": 100 },
                "correction": { "type": "string", "minLength": 1, "maxLength": 3000 },
                "category": { "enum": ["meaning", "diction", "grammar", "detail"] },
                "explanation_en": { "type": "string", "minLength": 1, "maxLength": 5000 },
                "note_vi": { "type": "string", "minLength": 1, "maxLength": 5000 },
                "start_offset": { "type": "integer", "minimum": 0 },
                "end_offset": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "revised_article": { "type": "string", "minLength": 1, "maxLength": 30000 },
    "key_lessons": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "explanation", "example"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 5000 },
          "example": { "type": "string", "minLength": 1, "maxLength": 3000 }
        }
      }
    },
    "editing_checklist": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "description": { "type": "string", "minLength": 1, "maxLength": 3000 }
        }
      }
    }
  }
}
